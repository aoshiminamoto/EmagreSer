# Copie para .env e preencha com valores locais. Nunca comite segredos.
DATABASE_URL=postgresql://emagreser:troque-me@127.0.0.1:55432/emagreser
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=troque-me
COOKIE_SECRET=troque-me
APP_ORIGIN=http://localhost:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com
SMTP_URL=smtp://localhost:1025
SMTP_FROM=EmagreSer <nao-responda@emagreser.local>
#Em produção mantenha true; false só para desenvolvimento HTTP local.
COOKIE_SECURE=false
PUBLIC_STATS_MIN_USERS=50
PORT=3000
NODE_ENV=development

# Apenas build de desenvolvimento. Produção deve manter ambas desligadas.
VITE_ALLOW_DESKTOP=false
VITE_FORCE_LOCALES=false
