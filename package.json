{
  "name": "emagreser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/domain"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check:prod-env": "node scripts/check-prod-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@stylistic/eslint-plugin": "^5.1.0",
    "@types/node": "^24.19.4",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2",
    "yaml-eslint-parser": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
